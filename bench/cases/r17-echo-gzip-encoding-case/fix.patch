+// isGzipContentEncoding reports whether Content-Encoding is gzip.
+// Content codings are case-insensitive per RFC 9110 §8.4.1.
+func isGzipContentEncoding(v string) bool {
+	return strings.EqualFold(v, GZIPEncoding)
